      "cost": "Antigravity credits",
      "probe": [
        "agy",
        "--print",
        "Reply with exactly: OK",
        "--model",
        "gemini-3.8-flash-high",
        "--output-format",
        "text"
      ]
    },
    "kiro-sonnet": {
      "agent": "kiro",
      "model": "claude-sonnet-5.5",
      "launch": "shell",
      "cost": "Kiro credits",
      "probe": [
        "kiro-cli",
        "chat",
        "--no-interactive",
        "--model",
        "claude-sonnet-5.5",
        "--trust-tools=",
        "Reply with exactly: OK"
      ]
    },
    "kiro-opus": {
      "agent": "kiro",
      "model": "claude-opus-5.5",
      "launch": "shell",
      "cost": "Kiro credits",
