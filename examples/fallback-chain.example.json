      "model": "opencode-go/glm-5.3-flash",
      "launch": "shell",
      "cost": "opencode provider quota",
      "probe": [
        "opencode2",
        "run",
        "-m",
        "opencode-go/glm-5.3-flash",
        "Reply with exactly: OK"
      ]
    },
    "opencode-haiku": {
      "agent": "opencode2",
      "model": "opencode-go/claude-haiku-5-5",
