      "probe": [
        "opencode2",
        "run",
        "-m",
        "opencode/muse-spark-1.3-contributor-free",
        "Reply with exactly: OK"
      ]
    },
    "kiro-gpt-terra": {
      "agent": "kiro",
      "model": "gpt-5.6-terra",
