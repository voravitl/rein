{
  "description": "rein guard: active only inside a worker worktree that has a task contract; silent everywhere else.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/rein", "args": ["hook"], "timeout": 10 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/rein", "args": ["hook"], "timeout": 10 }]
      }
    ]
  }
}
