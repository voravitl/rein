{
  "_doc": "Example fallback chains for `rein providers`. Copy to ~/.config/rein/fallback-chain.json (or set PIPELINE_FALLBACK) and edit providers, models and costs to your own accounts. Review chains should list strong models only.",
  "providers": {
    "claude-sonnet": {
      "agent": "claude",
      "model": "claude-sonnet-5-5",
      "launch": "orca",
      "cost": "Claude quota",
      "probe": [
        "claude",
        "-p",
        "--model",
        "claude-sonnet-5-5",
        "Reply with exactly: OK"
      ]
    },
    "claude-opus": {
      "agent": "claude",
      "model": "claude-opus-5-5",
      "launch": "orca",
      "cost": "Claude quota",
      "probe": [
        "claude",
        "-p",
        "--model",
        "claude-opus-5-5",
        "Reply with exactly: OK"
      ]
    },
    "claude-haiku": {
      "agent": "claude",
      "model": "claude-haiku-5-5",
      "launch": "orca",
      "cost": "Claude quota",
      "probe": [
        "claude",
        "-p",
        "--model",
        "claude-haiku-5-5",
        "Reply with exactly: OK"
      ]
    },
    "codex": {
      "agent": "codex",
      "model": "gpt-6.1-sol",
      "launch": "shell",
      "cost": "codex quota",
      "probe": [
        "codex",
        "exec",
        "-s",
        "read-only",
        "--skip-git-repo-check",
        "--ephemeral",
        "-m",
        "gpt-6.1-sol",
        "Reply with exactly: OK"
      ]
    },
    "antigravity": {
      "agent": "antigravity",
      "model": "gemini-3.8-flash-high",
