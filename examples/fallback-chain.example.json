        "claude",
        "-p",
        "--model",
        "claude-sonnet-5-5",
        "Reply with exactly: OK"
      ],
      "capabilities": [
        "repository-edit",
        "tests"
      ],
      "context_tokens": 200000,
      "billing": {
        "mode": "subscription",
        "unit": "subscription_percent",
        "pool": "claude/max/5h"
      },
      "probe_bound": {
        "calls": 1,
        "amount": 0.3
      }
    },
