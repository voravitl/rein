{
  "description": "rein: SessionStart installs the guard binary into the plugin data dir; the guard is active only inside a worker worktree that has a task contract and silent everywhere else.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/ensure-binary.sh\"", "timeout": 300 }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Agent",
        "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_DATA}/bin/rein", "args": ["hook"], "timeout": 10 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_DATA}/bin/rein", "args": ["hook"], "timeout": 10 }]
      }
    ]
  }
}
